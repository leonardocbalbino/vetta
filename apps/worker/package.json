    "@socket.io/redis-emitter": "^5.1.0",
    "@vetta/contracts": "workspace:*",
    "@vetta/db": "workspace:*",
    "@vetta/server": "workspace:*",
    "bullmq": "^5.61.0",
    "ffmpeg-static": "^5.2.0",
    "ioredis": "^5.8.0",
    "pino": "^9.13.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vetta/config": "workspace:*",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
