# apps/worker — copie para apps/worker/.env
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://vetta:vetta@localhost:5432/vetta?schema=public
REDIS_URL=redis://localhost:6379
APP_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=
APP_WEB_URL=http://localhost:3000

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=vetta-media
S3_ACCESS_KEY_ID=vetta
S3_SECRET_ACCESS_KEY=vetta-s3-secret
S3_FORCE_PATH_STYLE=true

# E-mail: smtp (Mailpit em dev, UI em http://localhost:8025) ou resend
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Vetta <nao-responda@vettafit.com.br>
RESEND_API_KEY=

# Push (Expo). Opcional em dev.
EXPO_ACCESS_TOKEN=

# Antivírus: `docker compose --profile full up -d clamav` e CLAMAV_ENABLED=true. Obrigatório em produção.
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Vídeo: local (ffmpeg), cloudflare ou mux
VIDEO_PROVIDER=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_SUBDOMAIN=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

WORKER_CONCURRENCY=4
MEDIA_CONCURRENCY=2
SENTRY_DSN=

# Fase 3 – WhatsApp (Cloud API da Meta ou BSP compatível) e SMS de segurança.
# SMS: o normal é configurar no admin (Integrações). Estas variáveis só valem se o admin não tiver nenhum ligado.
WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Domínio próprio e Google Calendar (verificação e sincronização periódicas)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SAAS_TOKEN=
CUSTOM_DOMAIN_TARGET=custom.vettafit.com.br
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
