# apps/api — copie para apps/api/.env (o schema em src/config/env.ts valida tudo na inicialização)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://vetta:vetta@localhost:5432/vetta?schema=public
REDIS_URL=redis://localhost:6379

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=

APP_WEB_URL=http://localhost:3000
APP_ADMIN_URL=http://localhost:3001
APP_SITE_URL=http://localhost:3002
APP_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081

# Storage S3 (dev: SeaweedFS do docker compose; produção: Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=vetta-media
S3_ACCESS_KEY_ID=vetta
S3_SECRET_ACCESS_KEY=vetta-s3-secret
S3_FORCE_PATH_STYLE=true

# Login social (IDs de cliente OAuth separados por vírgula)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
SWAGGER_ENABLED=true
SENTRY_DSN=

# Fase 3 – IA de treino (sem chave, as rotas de IA respondem 503)
# IA de treino: groq (padrão quando há GROQ_API_KEY) ou anthropic
AI_PROVIDER=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Vazio = padrão do provedor (openai/gpt-oss-20b na Groq, claude-opus-5-5 na Anthropic)
AI_MODEL=
AI_EFFORT=medium
AI_REFUSAL_FALLBACK=true

# Fase 3 – domínio próprio (Cloudflare for SaaS) e Google Calendar
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SAAS_TOKEN=
CUSTOM_DOMAIN_TARGET=custom.vettafit.com.br
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
