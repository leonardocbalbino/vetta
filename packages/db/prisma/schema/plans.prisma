// ─── Planos, features, assinatura da plataforma ────────────────────────────

enum PlanCode {
  FREE
  PRO
  PRO_PLUS
}

enum FeatureType {
  BOOLEAN
  LIMIT
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  PIX
  BOLETO
  CREDIT_CARD
}

model Plan {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        PlanCode @unique
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isPublic    Boolean  @default(true) @map("is_public")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  features      PlanFeature[]
  prices        PlanPrice[]
  subscriptions TenantSubscription[]
  pendingFor    TenantSubscription[] @relation("PendingPlan")
  invoices      PlatformInvoice[]

  @@map("plans")
}

/// Catálogo de features. Valores: BOOLEAN = 0/1; LIMIT = número (-1 ilimitado).
model Feature {
  key          String      @id
  type         FeatureType
  module       String
  name         String
  description  String?
  defaultValue Int         @default(0) @map("default_value")
  unit         String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  planValues PlanFeature[]
  overrides  TenantFeatureOverride[]

  @@map("features")
}

model PlanFeature {
  id         String   @id @default(uuid(7)) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  featureKey String   @map("feature_key")
  value      Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

model PlanPrice {
  id             String       @id @default(uuid(7)) @db.Uuid
  planId         String       @map("plan_id") @db.Uuid
  cycle          BillingCycle
  amountCents    Int          @map("amount_cents")
  currency       String       @default("BRL") @db.Char(3)
  isActive       Boolean      @default(true) @map("is_active")
  gatewayPriceId String?      @map("gateway_price_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, cycle])
  @@map("plan_prices")
}

model TenantSubscription {
  id                    String             @id @default(uuid(7)) @db.Uuid
  tenantId              String             @unique @map("tenant_id") @db.Uuid
  planId                String             @map("plan_id") @db.Uuid
  status                SubscriptionStatus
  cycle                 BillingCycle       @default(MONTHLY)
  trialEndsAt           DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  trialEndingNotifiedAt DateTime?          @map("trial_ending_notified_at") @db.Timestamptz(3)
  currentPeriodStart    DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd      DateTime?          @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd     Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt            DateTime?          @map("canceled_at") @db.Timestamptz(3)
  couponId              String?            @map("coupon_id") @db.Uuid
  gatewayCustomerId     String?            @map("gateway_customer_id")
  gatewaySubscriptionId String?            @map("gateway_subscription_id")
  paymentMethod         PaymentMethod?     @map("payment_method")
  /// Token do cartão no gateway (cifrado). Nunca guardamos o número.
  cardTokenEncrypted    String?            @map("card_token_encrypted")
  cardBrand             String?            @map("card_brand")
  cardLast4             String?            @map("card_last4")
  /// Cobranças já feitas com o cupom (duração em ciclos).
  couponCyclesUsed      Int                @default(0) @map("coupon_cycles_used")
  /// Crédito de pró-rata que sobrou para as próximas cobranças.
  creditCents           Int                @default(0) @map("credit_cents")
  /// Downgrade agendado para o fim do período.
  pendingPlanId         String?            @map("pending_plan_id") @db.Uuid
  pendingCycle          BillingCycle?      @map("pending_cycle")
  pastDueSince          DateTime?          @map("past_due_since") @db.Timestamptz(3)
  graceEndsAt           DateTime?          @map("grace_ends_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  plan        Plan              @relation(fields: [planId], references: [id])
  pendingPlan Plan?             @relation("PendingPlan", fields: [pendingPlanId], references: [id])
  coupon      Coupon?           @relation(fields: [couponId], references: [id])
  invoices    PlatformInvoice[]

  @@index([status, trialEndsAt])
  @@index([status, graceEndsAt])
  @@map("tenant_subscriptions")
}

model TenantFeatureOverride {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  featureKey       String    @map("feature_key")
  value            Int
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  reason           String
  createdByAdminId String?   @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  feature   Feature    @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  createdBy AdminUser? @relation(fields: [createdByAdminId], references: [id])

  @@unique([tenantId, featureKey])
  @@index([expiresAt])
  @@map("tenant_feature_overrides")
}

model Coupon {
  id               String       @id @default(uuid(7)) @db.Uuid
  code             String       @unique
  description      String?
  discountType     DiscountType @map("discount_type")
  percentOff       Int?         @map("percent_off")
  amountOffCents   Int?         @map("amount_off_cents")
  durationCycles   Int?         @map("duration_cycles")
  maxRedemptions   Int?         @map("max_redemptions")
  redemptionsCount Int          @default(0) @map("redemptions_count")
  planCodes        PlanCode[]   @map("plan_codes")
  validFrom        DateTime?    @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime?    @map("valid_until") @db.Timestamptz(3)
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(3)

  subscriptions TenantSubscription[]
  invoices      PlatformInvoice[]

  @@map("coupons")
}

/// Fatura da assinatura do personal com a plataforma.
model PlatformInvoice {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  subscriptionId   String         @map("subscription_id") @db.Uuid
  couponId         String?        @map("coupon_id") @db.Uuid
  amountCents      Int            @map("amount_cents")
  discountCents    Int            @default(0) @map("discount_cents")
  status           InvoiceStatus  @default(PENDING)
  method           PaymentMethod?
  dueDate          DateTime       @map("due_date") @db.Date
  paidAt           DateTime?      @map("paid_at") @db.Timestamptz(3)
  periodStart      DateTime       @map("period_start") @db.Timestamptz(3)
  periodEnd        DateTime       @map("period_end") @db.Timestamptz(3)
  gatewayInvoiceId String?        @unique @map("gateway_invoice_id")
  invoiceUrl       String?        @map("invoice_url")
  planId           String?        @map("plan_id") @db.Uuid
  cycle            BillingCycle?
  /// Crédito de pró-rata abatido nesta fatura.
  creditCents      Int            @default(0) @map("credit_cents")
  description      String?
  pixQrCode        String?        @map("pix_qr_code")
  pixCopyPaste     String?        @map("pix_copy_paste")
  boletoUrl        String?        @map("boleto_url")
  failureReason    String?        @map("failure_reason")
  failedAt         DateTime?      @map("failed_at") @db.Timestamptz(3)
  refundedAt       DateTime?      @map("refunded_at") @db.Timestamptz(3)
  refundedCents    Int            @default(0) @map("refunded_cents")
  /// Deslocamentos da régua já avisados (ex.: -7, -1, 0).
  remindersSent    Int[]          @map("reminders_sent")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(3)

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  subscription  TenantSubscription @relation(fields: [subscriptionId], references: [id])
  coupon        Coupon?            @relation(fields: [couponId], references: [id])
  plan          Plan?              @relation(fields: [planId], references: [id])
  fiscalInvoice FiscalInvoice?

  @@index([tenantId, status])
  @@index([status, dueDate])
  @@index([paidAt])
  @@map("platform_invoices")
}

enum FiscalInvoiceStatus {
  PENDING
  PENDING_CONFIG
  PROCESSING
  ISSUED
  FAILED
  CANCELED
}

/// Nota fiscal de serviço (NFS-e) emitida pela Vetta para a fatura da plataforma.
model FiscalInvoice {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  platformInvoiceId String              @unique @map("platform_invoice_id") @db.Uuid
  provider          String              @default("NFEIO")
  externalId        String?             @unique @map("external_id")
  status            FiscalInvoiceStatus @default(PENDING)
  number            String?
  amountCents       Int                 @map("amount_cents")
  pdfUrl            String?             @map("pdf_url")
  xmlUrl            String?             @map("xml_url")
  error             String?
  attempts          Int                 @default(0)
  issuedAt          DateTime?           @map("issued_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(3)

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  platformInvoice PlatformInvoice @relation(fields: [platformInvoiceId], references: [id])

  @@index([status])
  @@map("fiscal_invoices")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Webhooks recebidos. Único por provedor + id do evento: cada evento é processado uma vez.
model WebhookEvent {
  id          String             @id @default(uuid(7)) @db.Uuid
  provider    String
  eventId     String             @map("event_id")
  type        String
  /// Id do recurso no gateway (cobrança, assinatura, conta).
  resourceId  String?            @map("resource_id")
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  error       String?
  attempts    Int                @default(0)
  receivedAt  DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([resourceId])
  @@map("webhook_events")
}

/// Conciliação diária: nossas faturas x cobranças no gateway.
model ReconciliationRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  date       DateTime  @unique @db.Date
  status     String    @default("RUNNING")
  checked    Int       @default(0)
  fixed      Int       @default(0)
  /// [{ kind, invoiceId, gatewayId, ours, theirs, action }]
  mismatches Json      @default("[]")
  error      String?
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  @@map("reconciliation_runs")
}
