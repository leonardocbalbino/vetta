// ─── Identidade, tenants, sessões, consentimento, auditoria ────────────────

enum PlatformRole {
  SUPER_ADMIN
  ADMIN_OPERADOR
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum TenantMemberRole {
  OWNER
  ASSISTANT
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum StudentLinkStatus {
  INVITED
  ACTIVE
  PAUSED
  OVERDUE
  ARCHIVED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  APPLE
  MAGIC_LINK
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MAGIC_LINK
  STUDENT_INVITE
  TEAM_INVITE
  TWO_FACTOR_CHALLENGE
}

enum ConsentType {
  TERMS
  PRIVACY
  HEALTH_DATA
  MARKETING
  WHATSAPP
}

enum DocumentType {
  CPF
  CNPJ
}

enum Sex {
  FEMALE
  MALE
  OTHER
}

/// Usuário global: personal, assistente e aluno (pode ser aluno de vários personais).
model User {
  id                      String     @id @default(uuid(7)) @db.Uuid
  email                   String     @unique
  emailVerifiedAt         DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  passwordHash            String?    @map("password_hash")
  name                    String
  phone                   String?
  avatarMediaId           String?    @map("avatar_media_id") @db.Uuid
  locale                  String     @default("pt-BR")
  timezone                String     @default("America/Sao_Paulo")
  status                  UserStatus @default(PENDING)
  twoFactorSecret         String?    @map("two_factor_secret")
  twoFactorEnabledAt      DateTime?  @map("two_factor_enabled_at") @db.Timestamptz(3)
  twoFactorRecoveryCodes  String[]   @map("two_factor_recovery_codes")
  quietHoursEnabled       Boolean    @default(true) @map("quiet_hours_enabled")
  quietHoursStart         String     @default("22:00") @map("quiet_hours_start")
  quietHoursEnd           String     @default("07:00") @map("quiet_hours_end")
  trainingReminderEnabled Boolean    @default(false) @map("training_reminder_enabled")
  /// "HH:MM" no fuso do usuário.
  trainingReminderTime    String?    @map("training_reminder_time")
  birthDate               DateTime?  @map("birth_date") @db.Date
  lastLoginAt             DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?  @map("deleted_at") @db.Timestamptz(3)

  identities              UserIdentity[]
  ownedTenants            Tenant[]                 @relation("TenantOwner")
  memberships             TenantMember[]
  studentLinks            StudentLink[]
  sessions                Session[]
  authTokens              AuthToken[]
  devices                 Device[]
  consents                Consent[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  ownedMedia              Media[]                  @relation("MediaOwnerUser")
  academyProgress         AcademyProgress[]
  healthSamples           HealthSample[]

  @@map("users")
}

model UserIdentity {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  email          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_identities")
}

/// Equipe da plataforma (SUPER_ADMIN, ADMIN_OPERADOR). 2FA obrigatório.
model AdminUser {
  id                     String       @id @default(uuid(7)) @db.Uuid
  email                  String       @unique
  name                   String
  passwordHash           String       @map("password_hash")
  role                   PlatformRole
  twoFactorSecret        String?      @map("two_factor_secret")
  twoFactorEnabledAt     DateTime?    @map("two_factor_enabled_at") @db.Timestamptz(3)
  twoFactorRecoveryCodes String[]     @map("two_factor_recovery_codes")
  isActive               Boolean      @default(true) @map("is_active")
  lastLoginAt            DateTime?    @map("last_login_at") @db.Timestamptz(3)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?    @map("deleted_at") @db.Timestamptz(3)

  sessions         Session[]               @relation("AdminSession")
  impersonations   Session[]               @relation("Impersonator")
  authTokens       AuthToken[]
  featureOverrides TenantFeatureOverride[]
  ownedMedia       Media[]                 @relation("MediaOwnerAdmin")

  @@map("admin_users")
}

/// Tenant = negócio do personal.
model Tenant {
  id                    String        @id @default(uuid(7)) @db.Uuid
  slug                  String        @unique
  name                  String
  ownerUserId           String        @map("owner_user_id") @db.Uuid
  status                TenantStatus  @default(ACTIVE)
  cref                  String?
  crefState             String?       @map("cref_state") @db.Char(2)
  legalName             String?       @map("legal_name")
  documentType          DocumentType? @map("document_type")
  documentNumber        String?       @map("document_number")
  billingEmail          String?       @map("billing_email")
  phone                 String?
  addressStreet         String?       @map("address_street")
  addressNumber         String?       @map("address_number")
  addressComplement     String?       @map("address_complement")
  addressDistrict       String?       @map("address_district")
  addressCity           String?       @map("address_city")
  addressState          String?       @map("address_state") @db.Char(2)
  addressZip            String?       @map("address_zip")
  timezone              String        @default("America/Sao_Paulo")
  locale                String        @default("pt-BR")
  bio                   String?
  /// Dias sem treinar para o alerta de aluno sumido.
  inactivityAlertDays   Int           @default(5) @map("inactivity_alert_days")
  /// Passos concluídos do onboarding guiado (profile, first_student, first_workout).
  onboardingSteps       String[]      @map("onboarding_steps")
  /// Bloqueia o aluno inadimplente depois de N dias de atraso.
  blockOverdueStudents  Boolean       @default(false) @map("block_overdue_students")
  blockOverdueAfterDays Int           @default(5) @map("block_overdue_after_days")
  /// Antecedência mínima (h) para o aluno agendar e cancelar.
  bookingMinHours       Int           @default(2) @map("booking_min_hours")
  cancelMinHours        Int           @default(12) @map("cancel_min_hours")
  /// Lembrete de reavaliação física a cada N dias (null = desligado).
  reassessmentDays      Int?          @map("reassessment_days")
  blockedAt             DateTime?     @map("blocked_at") @db.Timestamptz(3)
  blockedReason         String?       @map("blocked_reason")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamptz(3)

  owner User @relation("TenantOwner", fields: [ownerUserId], references: [id])

  members              TenantMember[]
  studentLinks         StudentLink[]
  subscription         TenantSubscription?
  featureOverrides     TenantFeatureOverride[]
  platformInvoices     PlatformInvoice[]
  media                Media[]
  storageUsage         TenantStorageUsage?
  studentGroups        StudentGroup[]
  studentGroupMembers  StudentGroupMember[]
  studentActivities    StudentActivity[]
  exerciseFolders      ExerciseFolder[]
  exercises            Exercise[]
  exerciseFavorites    ExerciseFavorite[]
  workoutPrograms      WorkoutProgram[]
  workoutRoutines      WorkoutRoutine[]
  routineExercises     RoutineExercise[]
  exerciseSets         ExerciseSet[]
  periodizations       Periodization[]
  periodizationPhases  PeriodizationPhase[]
  workoutSessions      WorkoutSession[]
  sessionSetLogs       SessionSetLog[]
  personalRecords      PersonalRecord[]
  anamnesisTemplates   AnamnesisTemplate[]
  anamnesisResponses   AnamnesisResponse[]
  physicalAssessments  PhysicalAssessment[]
  postureAssessments   PostureAssessment[]
  posturePhotos        PosturePhoto[]
  progressPhotos       ProgressPhoto[]
  bodyMeasurements     BodyMeasurement[]
  conversations        Conversation[]
  messages             Message[]
  broadcasts           Broadcast[]
  appointments         Appointment[]
  calendarIntegrations CalendarIntegration[]
  consultingPlans      ConsultingPlan[]
  studentSubscriptions StudentSubscription[]
  invoices             Invoice[]
  paymentAccount       PaymentAccount?
  withdrawals          Withdrawal[]
  walletEntries        WalletEntry[]
  expenses             Expense[]
  brand                TenantBrand?
  aiGenerations        AiGeneration[]
  salesPage            SalesPage?
  studentDocuments     StudentDocument[]
  consents             Consent[]
  kycDocuments         KycDocument[]
  checkouts            Checkout[]
  appointmentAttendees AppointmentAttendee[]
  availabilityRules    AvailabilityRule[]
  scheduleBlocks       ScheduleBlock[]
  testimonials         Testimonial[]
  salesPageResults     SalesPageResult[]
  anamnesisAssignments AnamnesisAssignment[]
  fiscalInvoices       FiscalInvoice[]

  @@index([ownerUserId])
  @@map("tenants")
}

model TenantMember {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        TenantMemberRole
  status      MemberStatus     @default(ACTIVE)
  invitedAt   DateTime?        @map("invited_at") @db.Timestamptz(3)
  /// Permissões do assistente: prescribe, assess, chat (o dono ignora).
  permissions String[]         @default(["prescribe", "assess", "chat"])
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(3)

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
  assignedStudents     StudentLink[]         @relation("AssignedAssistant")
  programs             WorkoutProgram[]
  appointments         Appointment[]
  calendarIntegrations CalendarIntegration[]
  availabilityRules    AvailabilityRule[]
  scheduleBlocks       ScheduleBlock[]
  physicalAssessments  PhysicalAssessment[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_members")
}

/// Vínculo aluno x personal (tenant).
model StudentLink {
  id                    String            @id @default(uuid(7)) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  userId                String?           @map("user_id") @db.Uuid
  displayName           String            @map("display_name")
  email                 String?
  phone                 String?
  status                StudentLinkStatus @default(INVITED)
  assistantMemberId     String?           @map("assistant_member_id") @db.Uuid
  birthDate             DateTime?         @map("birth_date") @db.Date
  sex                   Sex?
  goal                  String?
  level                 String?
  restrictions          String?
  injuries              String?
  whatsapp              String?
  emergencyContactName  String?           @map("emergency_contact_name")
  emergencyContactPhone String?           @map("emergency_contact_phone")
  tags                  String[]
  /// Observações privadas do personal (o aluno não vê).
  notes                 String?
  inactivityNotifiedAt  DateTime?         @map("inactivity_notified_at") @db.Timestamptz(3)
  invitedAt             DateTime?         @map("invited_at") @db.Timestamptz(3)
  joinedAt              DateTime?         @map("joined_at") @db.Timestamptz(3)
  archivedAt            DateTime?         @map("archived_at") @db.Timestamptz(3)
  archivedReason        String?           @map("archived_reason")
  lastActivityAt        DateTime?         @map("last_activity_at") @db.Timestamptz(3)
  lastWorkoutAt         DateTime?         @map("last_workout_at") @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?         @map("deleted_at") @db.Timestamptz(3)

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])
  assistant TenantMember? @relation("AssignedAssistant", fields: [assistantMemberId], references: [id])

  groupMemberships     StudentGroupMember[]
  activities           StudentActivity[]
  programs             WorkoutProgram[]
  periodizations       Periodization[]
  workoutSessions      WorkoutSession[]
  personalRecords      PersonalRecord[]
  anamnesisResponses   AnamnesisResponse[]
  physicalAssessments  PhysicalAssessment[]
  postureAssessments   PostureAssessment[]
  progressPhotos       ProgressPhoto[]
  bodyMeasurements     BodyMeasurement[]
  conversation         Conversation?
  appointments         Appointment[]
  subscriptions        StudentSubscription[]
  invoices             Invoice[]
  documents            StudentDocument[]
  media                Media[]
  appointmentAttendees AppointmentAttendee[]
  testimonials         Testimonial[]
  salesPageResults     SalesPageResult[]
  anamnesisAssignments AnamnesisAssignment[]

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, assistantMemberId])
  @@index([userId])
  @@map("student_links")
}

/// Sessão por dispositivo; refresh tokens rotativos em refresh_tokens.
model Session {
  id                  String         @id @default(uuid(7)) @db.Uuid
  userId              String?        @map("user_id") @db.Uuid
  adminUserId         String?        @map("admin_user_id") @db.Uuid
  deviceName          String?        @map("device_name")
  platform            DevicePlatform @default(WEB)
  ip                  String?
  userAgent           String?        @map("user_agent")
  authMethod          AuthProvider   @default(PASSWORD) @map("auth_method")
  impersonatorAdminId String?        @map("impersonator_admin_id") @db.Uuid
  impersonationReason String?        @map("impersonation_reason")
  lastUsedAt          DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt           DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedReason       String?        @map("revoked_reason")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser     AdminUser?     @relation("AdminSession", fields: [adminUserId], references: [id], onDelete: Cascade)
  impersonator  AdminUser?     @relation("Impersonator", fields: [impersonatorAdminId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([adminUserId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Preenchido quando o token é trocado; reapresentá-lo = reuso.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Tokens de uso único (verificação, reset, magic link, convite, desafio 2FA).
model AuthToken {
  id          String        @id @default(uuid(7)) @db.Uuid
  type        AuthTokenType
  tokenHash   String        @unique @map("token_hash")
  userId      String?       @map("user_id") @db.Uuid
  adminUserId String?       @map("admin_user_id") @db.Uuid
  tenantId    String?       @map("tenant_id") @db.Uuid
  metadata    Json          @default("{}")
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Device {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  pushToken  String         @unique @map("push_token")
  platform   DevicePlatform
  name       String?
  appVersion String?        @map("app_version")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  disabledAt DateTime?      @map("disabled_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

/// Consentimento LGPD versionado. Dados de saúde exigem HEALTH_DATA por tenant.
model Consent {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  tenantId  String?     @map("tenant_id") @db.Uuid
  type      ConsentType
  version   String
  granted   Boolean
  ip        String?
  userAgent String?     @map("user_agent")
  grantedAt DateTime    @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt DateTime?   @map("revoked_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId, type])
  @@map("consents")
}

/// Trilha de auditoria (append-only).
model AuditLog {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tenantId            String?  @map("tenant_id") @db.Uuid
  actorUserId         String?  @map("actor_user_id") @db.Uuid
  actorAdminId        String?  @map("actor_admin_id") @db.Uuid
  impersonatorAdminId String?  @map("impersonator_admin_id") @db.Uuid
  action              String
  resource            String
  resourceId          String?  @map("resource_id")
  ip                  String?
  userAgent           String?  @map("user_agent")
  requestId           String?  @map("request_id")
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorAdminId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}
