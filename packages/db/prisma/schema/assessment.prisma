// ─── M3 Anamnese, M4 Avaliação física/postural, M8 Progresso ────────────────

enum AnamnesisKind {
  PARQ
  GENERAL_HEALTH
  INJURIES
  CUSTOM
}

enum AnamnesisStatus {
  PENDING
  ANSWERED
  EXPIRED
}

enum BodyCompositionProtocol {
  POLLOCK_3
  POLLOCK_7
  JACKSON_POLLOCK
  GUEDES
  PETROSKI
  FAULKNER
  DURNIN_WOMERSLEY
  BIOIMPEDANCE
  NONE
}

enum PhotoView {
  FRONT
  BACK
  LEFT
  RIGHT
}

enum MeasurementSource {
  MANUAL
  ASSESSMENT
  STUDENT
}

/// tenant_id nulo = modelo pronto da plataforma (PAR-Q, saúde geral, lesões).
model AnamnesisTemplate {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String?       @map("tenant_id") @db.Uuid
  kind        AnamnesisKind
  name        String
  description String?
  /// Definição das perguntas (construtor de formulários).
  schema      Json
  version     Int           @default(1)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  tenant    Tenant?             @relation(fields: [tenantId], references: [id])
  responses AnamnesisResponse[]

  @@index([tenantId, kind])
  @@map("anamnesis_templates")
}

model AnamnesisResponse {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  studentLinkId   String          @map("student_link_id") @db.Uuid
  templateId      String          @map("template_id") @db.Uuid
  templateVersion Int             @map("template_version")
  status          AnamnesisStatus @default(PENDING)
  answers         Json            @default("{}")
  dueAt           DateTime?       @map("due_at") @db.Timestamptz(3)
  /// PAR-Q com alguma resposta "sim" (ou risco no modelo).
  hasRisk         Boolean         @default(false) @map("has_risk")
  reviewedAt      DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  requestedAt     DateTime        @default(now()) @map("requested_at") @db.Timestamptz(3)
  answeredAt      DateTime?       @map("answered_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  studentLink StudentLink       @relation(fields: [studentLinkId], references: [id])
  template    AnamnesisTemplate @relation(fields: [templateId], references: [id])

  @@index([tenantId, studentLinkId])
  @@map("anamnesis_responses")
}

model PhysicalAssessment {
  id               String                  @id @default(uuid(7)) @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  studentLinkId    String                  @map("student_link_id") @db.Uuid
  assessorMemberId String?                 @map("assessor_member_id") @db.Uuid
  assessedAt       DateTime                @map("assessed_at") @db.Timestamptz(3)
  protocol         BodyCompositionProtocol @default(NONE)
  weightKg         Decimal?                @map("weight_kg") @db.Decimal(6, 2)
  heightCm         Decimal?                @map("height_cm") @db.Decimal(5, 1)
  /// Dobras cutâneas em mm por sítio.
  skinfolds        Json                    @default("{}")
  /// Perimetria em cm por região.
  perimeters       Json                    @default("{}")
  bioimpedance     Json                    @default("{}")
  /// Resultados calculados por @vetta/fitness (IMC, % gordura, massa magra, RCQ...).
  results          Json                    @default("{}")
  equation         String                  @default("siri")
  nextAssessmentOn DateTime?               @map("next_assessment_on") @db.Date
  reminderSentAt   DateTime?               @map("reminder_sent_at") @db.Timestamptz(3)
  pdfMediaId       String?                 @map("pdf_media_id") @db.Uuid
  notes            String?
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  studentLink StudentLink   @relation(fields: [studentLinkId], references: [id])
  assessor    TenantMember? @relation(fields: [assessorMemberId], references: [id])

  @@index([tenantId, studentLinkId, assessedAt])
  @@map("physical_assessments")
}

model PostureAssessment {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  studentLinkId String    @map("student_link_id") @db.Uuid
  assessedAt    DateTime  @map("assessed_at") @db.Timestamptz(3)
  findings      Json      @default("{}")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  studentLink StudentLink    @relation(fields: [studentLinkId], references: [id])
  photos      PosturePhoto[]

  @@index([tenantId, studentLinkId])
  @@map("posture_assessments")
}

model PosturePhoto {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  postureAssessmentId String    @map("posture_assessment_id") @db.Uuid
  mediaId             String    @map("media_id") @db.Uuid
  view                PhotoView
  /// Marcações (pontos e linhas) sobre a foto.
  markers             Json      @default("[]")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  postureAssessment PostureAssessment @relation(fields: [postureAssessmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, postureAssessmentId])
  @@map("posture_photos")
}

model ProgressPhoto {
  id            String     @id @default(uuid(7)) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  studentLinkId String     @map("student_link_id") @db.Uuid
  mediaId       String     @map("media_id") @db.Uuid
  view          PhotoView?
  takenAt       DateTime   @map("taken_at") @db.Timestamptz(3)
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  studentLink StudentLink @relation(fields: [studentLinkId], references: [id])

  @@index([tenantId, studentLinkId, takenAt])
  @@map("progress_photos")
}

model BodyMeasurement {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  studentLinkId String            @map("student_link_id") @db.Uuid
  measuredAt    DateTime          @map("measured_at") @db.Timestamptz(3)
  source        MeasurementSource @default(MANUAL)
  weightKg      Decimal?          @map("weight_kg") @db.Decimal(6, 2)
  bodyFatPct    Decimal?          @map("body_fat_pct") @db.Decimal(5, 2)
  measures      Json              @default("{}")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  studentLink StudentLink @relation(fields: [studentLinkId], references: [id])

  @@index([tenantId, studentLinkId, measuredAt])
  @@map("body_measurements")
}
