{
  "name": "@vetta/server",
  "version": "0.0.0",
  "private": true,
  "description": "Código de backend compartilhado entre apps/api e apps/worker (providers, regras de notificação, utilitários).",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@vetta/contracts": "workspace:*",
    "expo-server-sdk": "^3.15.0",
    "ffmpeg-static": "^5.2.0",
    "nodemailer": "^7.0.10",
    "resend": "^6.1.0",
    "zod": "^4.1.12",
    "@vetta/db": "workspace:*",
    "@vetta/emails": "workspace:*",
    "sharp": "^0.34.4",
    "heic-convert": "^2.1.0",
    "ioredis": "^5.8.0",
    "bullmq": "^5.61.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.2",
    "@vetta/config": "workspace:*",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "@types/heic-convert": "^2.1.0"
  }
}
