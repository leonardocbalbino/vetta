{
  "name": "vetta",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "node scripts/ensure-env.mjs && pnpm --filter @vetta/db build && pnpm --filter @vetta/db migrate:deploy && pnpm --filter @vetta/db seed:catalog && turbo run dev --filter=!@vetta/mobile --concurrency=20",
    "dev:mobile": "pnpm --filter @vetta/mobile dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @vetta/db migrate:dev",
    "db:deploy": "pnpm --filter @vetta/db migrate:deploy",
    "db:seed": "pnpm --filter @vetta/db seed",
    "db:reset": "pnpm --filter @vetta/db reset",
    "prepare": "husky",
    "setup": "node scripts/ensure-env.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@vetta/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}": "prettier --write --ignore-unknown"
  }
}
